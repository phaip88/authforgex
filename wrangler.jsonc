// AuthForge — Cloudflare Workers deployment manifest.
// Build first:  AF_TARGET=cloudflare npm run build && npx opennextjs-cloudflare build
// Secrets:      wrangler secret put AF_JWT_SECRET   (openssl rand -hex 32)
//               wrangler secret put DATABASE_URL     (Hyperdrive connection string)
{
  "name": "authforgex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // Required for node-postgres/postgres.js, node:crypto (timingSafeEqual),
  // Buffer and jose. Without it the Worker fails at bundle load.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Automatically run OpenNext build before any wrangler deploy / wrangler dev
  "build": {
    "command": "npm run build:worker"
  },

  // Static frontend (PWA shell) served from CDN-side asset storage.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Application env (non-secret).
  "vars": {
    "AF_API_VERSION": "v1"
  },

  // Cloudflare D1 native serverless database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authforge-db",
      "database_id": "1a2318d9-9558-4b15-b453-b379e7c90e30"
    }
  ]

  // ── Optional: edge rate limiting (front-line filter BEFORE hitting DB) ──
  // Cloudflare Rate Limiting bindings drop abusive traffic at the edge. The
  // app's Postgres-backed limiter (semantic per-user/per-email rules) stays as
  // defense-in-depth; these bindings only shed brute-force volume cheaply.
  // ,
  // "ratelimits": [
  //   { "name": "LOGIN_LIMITER", "namespace_id": 1001, "simple": { "limit": 5, "period": 60 } },
  //   { "name": "REGISTER_LIMITER", "namespace_id": 1002, "simple": { "limit": 5, "period": 3600 } }
  // ]
}
